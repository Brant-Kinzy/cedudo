{
  "read-logs": {
    "action_type": "Linux::Action",
    "action_id": "read-logs",
    "resource_type": "Linux::Service",
    "resource_id": "cedar-demo",
    "resource_attributes": {
      "environment": "workshop",
      "critical": false
    },
    "argv": [
      "/usr/bin/journalctl",
      "-u",
      "cedar-demo",
      "-n",
      "20",
      "--no-pager"
    ]
  },
  "view-status": {
    "action_type": "Linux::Action",
    "action_id": "view-status",
    "resource_type": "Linux::Service",
    "resource_id": "cedar-demo",
    "resource_attributes": {
      "environment": "workshop",
      "critical": false
    },
    "argv": [
      "/usr/bin/systemctl",
      "status",
      "cedar-demo",
      "--no-pager"
    ]
  },
  "restart": {
    "action_type": "Linux::Action",
    "action_id": "restart",
    "resource_type": "Linux::Service",
    "resource_id": "cedar-demo",
    "resource_attributes": {
      "environment": "workshop",
      "critical": false
    },
    "argv": [
      "/usr/bin/systemctl",
      "restart",
      "cedar-demo"
    ]
  },
  "restart-ssh": {
    "action_type": "Linux::Action",
    "action_id": "restart",
    "resource_type": "Linux::Service",
    "resource_id": "ssh",
    "resource_attributes": {
      "environment": "workshop",
      "critical": true
    },
    "argv": [
      "/usr/bin/systemctl",
      "restart",
      "ssh"
    ]
  }
}
